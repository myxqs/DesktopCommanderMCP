{
  "name": "native-rdc-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "CONNECTION_OWNER",
        "class_name": "NativeRdcConnectionOwner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NativeRdcConnectionOwner"]
    }
  ],
  "vars": {
    "DEVICE_ID": "native-rdc-windows-1"
  }
}
